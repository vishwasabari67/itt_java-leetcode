class MinStack {
    private Stack<Integer> a;
    private Stack<Integer> minstack;
    public MinStack() {
         a = new Stack<>();
         minstack = new Stack<>();
    }
    
    public void push(int value) {
        a.push(value);
        if(minstack.isEmpty() || value<=minstack.peek())
        {
            minstack.push(value);
        }
    }
    
    public void pop() {
        if (a.isEmpty()) 
        {
            return;
        }
        int popped = a.pop();
        if(popped == minstack.peek())
        {
            minstack.pop();
        }
    }
    
    public int top() {
        return a.peek();
    }
    
    public int getMin() {
        return minstack.peek();
    }
}

