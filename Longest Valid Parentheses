class Solution {
    public int longestValidParentheses(String s) {
        Stack<Integer> a = new Stack<>();
        a.push(-1);
        int max = 0;
        for(int i=0;i<s.length();i++)
        {
            char c = s.charAt(i);
            if(c=='(')
            {
                a.push(i);
            }
            else
            {
                a.pop();
                if(a.isEmpty())
                {
                    a.push(i);
                }
                else
                {
                    int len = i-a.peek();
                    max = Math.max(max,len);
                }
            }
        }
        return max;
    }
}
