class Solution {
    public int[] dailyTemperatures(int[] temperatures) {
        Stack<Integer> a = new Stack<>();
        int[] res = new int[temperatures.length];
        for(int i=temperatures.length-1;i>=0;i--)
        {
            while(!a.isEmpty() && temperatures[i]>=temperatures[a.peek()])
            {
                a.pop();
            }
            if(!a.isEmpty())
            {
                res[i]=a.peek()-i;
            }
            a.push(i);
        }
        return res;
    }
}
