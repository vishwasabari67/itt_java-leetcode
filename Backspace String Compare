class Solution {
    public boolean backspaceCompare(String s, String t) {
        return a(s).equals(a(t));
    }
    private String a(String str)
    {
        StringBuilder s1 = new StringBuilder();
        for(char i : str.toCharArray())
        {
            if(i!='#')
            {
                s1.append(i);
            }
            else if(s1.length()>0)
            {
                s1.deleteCharAt(s1.length()-1);
            }
        }
        return s1.toString();
    }
}
