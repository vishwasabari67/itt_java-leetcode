class MyStack {

    private Stack<Integer> a;

    public MyStack() {
        a=new Stack<>();
    }
    
    public void push(int x) {
        a.push(x);
        
    }
    
    public int pop() {
        return a.pop();
    }
    
    public int top() {
        return a.peek();
    }
    
    public boolean empty() {
        return a.isEmpty();
    }
}

