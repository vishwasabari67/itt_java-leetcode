class Solution {
    public int evalRPN(String[] tokens) {
        int n=tokens.length;
        Stack<Integer> s = new Stack<>();
        for(int i=0;i<n;i++)
        {
            if(tokens[i].equals("+"))
            {
                int n1=s.pop();
                int n2=s.pop();
                s.push(n1+n2);
            }
            else if(tokens[i].equals("*"))
            {
                int n1=s.pop();
                int n2=s.pop();
                s.push(n1*n2);
            }
            else if(tokens[i].equals("/"))
            {
                int n1=s.pop();
                int n2=s.pop();
                s.push(n2/n1);
            }
            else if(tokens[i].equals("-"))
            {
                int n1=s.pop();
                int n2=s.pop();
                s.push(n2-n1);
            }
            else
            {
                s.push(Integer.parseInt(tokens[i]));
            }
        }
        return s.pop();
    }
}
